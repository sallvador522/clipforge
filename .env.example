# ClipForge local configuration. Mock mode is the default and requires no credentials.
# Do NOT add real API keys during mock-first development.
CLIPFORGE_AI_MODE=mock

# Transcription, the director, SAM segmentation and Muse Image can run live
# independently (ADR-008/ADR-014/ADR-019). Leave all four as mock unless a live
# test has been explicitly approved. A live run also requires MODEL_API_KEY
# (server-side only, never exposed to the browser) and a live-call budget ledger.
# Put real values - including the API key - in `.env` (gitignored), never here.
CLIPFORGE_TRANSCRIBE_MODE=mock
CLIPFORGE_DIRECTOR_MODE=mock
CLIPFORGE_SEGMENTATION_MODE=mock
CLIPFORGE_IMAGE_MODE=mock

# Optional per-function live-call caps. Defaults are 2/2/2/2; the ledger never
# resets automatically. Raise only for an explicitly approved local testing phase.
# CLIPFORGE_LIVE_TRANSCRIPTION_LIMIT=2
# CLIPFORGE_LIVE_DIRECTOR_LIMIT=2
# CLIPFORGE_LIVE_SEGMENTATION_LIMIT=2
# CLIPFORGE_LIVE_IMAGE_LIMIT=2

# Development launchers (scripts/dev_api.py, scripts/dev_worker.py) force mock
# unless this explicit opt-in is set to 1. Do not enable it for normal development.
# CLIPFORGE_DEV_ALLOW_LIVE=1

# MODEL_API_KEY=

# --- REAL USER MODE (manual end-to-end testing with real Meta APIs) ---
# Salvador / single tester: keep your key in `.env`, then run
# `scripts/start_real_user.ps1` (Windows) or `scripts/start_real_user.sh`.
# It applies `scripts/real-user.env`, which switches all four providers to
# live. You are billed on your own Meta account.
# See docs/REAL_USER_TESTING.md. No live request is made at startup.

# --- JUDGE MODE (hackathon) ---
# Judges: copy this file to `.env`, paste your own Meta API key above, and
# start with `scripts/start_judge.ps1` (Windows) or `scripts/start_judge.sh`
# (macOS/Linux). The start script applies `scripts/judge.env`, which switches
# all four providers to live. You are billed on your own Meta account.
# See docs/JUDGE_QUICKSTART.md. No live request is made at startup.
