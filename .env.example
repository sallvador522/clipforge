# ClipForge local configuration. Mock mode is the default and requires no credentials.
# Do NOT add real API keys during mock-first development.
CLIPFORGE_AI_MODE=mock

# Transcription is the only live-capable provider (ADR-008). Leave as mock unless a
# live test has been explicitly approved; a live run also requires MODEL_API_KEY
# (server-side only, never exposed to the browser).
CLIPFORGE_TRANSCRIBE_MODE=mock
