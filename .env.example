# ClipForge local configuration. Mock mode is the default and requires no credentials.
# Do NOT add real API keys during mock-first development.
CLIPFORGE_AI_MODE=mock

# Only transcription and the director can run live (ADR-008/ADR-014). Leave both
# as mock unless a live test has been explicitly approved. A live run also requires
# MODEL_API_KEY (server-side only, never exposed to the browser) and a live-call
# budget ledger. Put real values - including the API key - in `.env` (gitignored),
# never here.
CLIPFORGE_TRANSCRIBE_MODE=mock
CLIPFORGE_DIRECTOR_MODE=mock

# Optional per-function live-call caps. Defaults are 2/2; the ledger never resets
# automatically. Raise only for an explicitly approved local testing phase.
# CLIPFORGE_LIVE_TRANSCRIPTION_LIMIT=2
# CLIPFORGE_LIVE_DIRECTOR_LIMIT=2

# Development launchers (scripts/dev_api.py, scripts/dev_worker.py) force mock
# unless this explicit opt-in is set to 1. Do not enable it for normal development.
# CLIPFORGE_DEV_ALLOW_LIVE=1

# MODEL_API_KEY=
