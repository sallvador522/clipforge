# ClipForge Judge profile (hackathon). Tracked in Git, contains NO secrets.
#
# Applied by scripts/start_judge.ps1 / scripts/start_judge.sh on top of the
# judge's own `.env` (which holds only MODEL_API_KEY). Explicitly enables all
# four live providers. Normal development stays mock: dev_api.py/dev_worker.py
# force mock unless CLIPFORGE_DEV_ALLOW_LIVE=1, which is set only here.
#
# No live request is made by applying this file; each model runs only when
# the judge requests its functionality in the Studio.

CLIPFORGE_TRANSCRIBE_MODE=live
CLIPFORGE_DIRECTOR_MODE=live
CLIPFORGE_SEGMENTATION_MODE=live
CLIPFORGE_IMAGE_MODE=live
CLIPFORGE_DEV_ALLOW_LIVE=1
