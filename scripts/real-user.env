# ClipForge REAL USER profile (local testing with real Meta APIs).
#
# Tracked in Git, contains NO secrets. Functionally identical to the judge
# profile; kept as a separate file so the real-user path is explicit and
# cannot drift silently. Applied by scripts/start_real_user.ps1 (Windows) and
# scripts/start_real_user.sh (macOS/Linux) on top of the user's own `.env`
# (which holds only MODEL_API_KEY). Explicitly enables all four live
# providers. Normal development and automated tests stay mock: dev_api.py /
# dev_worker.py force mock unless CLIPFORGE_DEV_ALLOW_LIVE=1, which is set
# only here (and in scripts/judge.env).
#
# Makes NO live request by applying this file. Each model runs only when the
# user requests it in the Studio.

CLIPFORGE_TRANSCRIBE_MODE=live
CLIPFORGE_DIRECTOR_MODE=live
CLIPFORGE_SEGMENTATION_MODE=live
CLIPFORGE_IMAGE_MODE=live
CLIPFORGE_DEV_ALLOW_LIVE=1
